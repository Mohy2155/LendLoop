# Copy to .env.local and fill in. Never commit real values.

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Frontend API URL for Convex auth (set on the Convex deployment with
# `npx convex env set CLERK_FRONTEND_API_URL <url>`, not here)
# CLERK_FRONTEND_API_URL=

# n8n integration (set in the Convex dashboard env vars and in n8n credentials)
# N8N_WEBHOOK_URL=
# N8N_SHARED_SECRET=
