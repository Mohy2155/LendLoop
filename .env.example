# Copy to .env.local and fill in. Never commit real values.

# Convex (written by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk (dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routes (local sign-in pages; do not add *_FORCE_REDIRECT_URL, it breaks return-after-sign-in)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/tools
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/tools

# Clerk Frontend API URL for Convex auth (set on the Convex deployment with
# `npx convex env set CLERK_FRONTEND_API_URL <url>`, not here)
# CLERK_FRONTEND_API_URL=

# n8n integration: set on the Convex deployment (`npx convex env set`), not here.
# The matching values for n8n itself go in n8n/.env (see n8n/.env.example).
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
