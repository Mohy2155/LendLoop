# Copy to .env (never commit .env). Use the same secret value as N8N_WEBHOOK_SECRET in Convex.
LENDLOOP_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public URL of n8n, ending in a slash. Convex cloud cannot reach localhost, so use a tunnel URL when testing with the app.
WEBHOOK_URL=http://localhost:5678/
